# `docker compose up --build` works without this file. Copy it to `.env` only
# when local host ports or browser-facing URLs need to change. Every value here
# is development-only; Compose itself supplies disposable local credentials.

POSTGRES_PORT=5433
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
BACKEND_PORT=8081
FRONTEND_PORT=3000

# Keep these three values aligned if you change a published port.
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8081
S3_PRESIGN_ENDPOINT=http://localhost:9010
NEXT_PUBLIC_STORAGE_ORIGIN=http://localhost:9010
FRONTEND_URL=http://localhost:3000
# Set these to test real email delivery. Keep them out of source control.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_VERIFICATION_EXPIRY_MINUTES=60
JWT_EXPIRATION=7200000
AUTH_LOGIN_IP_LIMIT=5
AUTH_LOGIN_IDENTIFIER_LIMIT=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REGISTER_IP_LIMIT=3
AUTH_REGISTER_EMAIL_LIMIT=3
AUTH_REGISTER_WINDOW_SECONDS=3600
