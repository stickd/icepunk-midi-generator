# Copy to .env.production and replace every placeholder before deployment.
POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=replace-with-a-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example
S3_PRESIGN_ENDPOINT=https://minio-api.your-domain.example
NEXT_PUBLIC_API_URL=https://api.your-domain.example

# The fixed private network created by docker-compose.production.yml. Attach nginx
# to icepunk-prod-backend before using this value; otherwise inspect and use the
# exact CIDR of the network that directly connects to backend.
TRUSTED_PROXY_CIDRS=172.30.0.0/24
