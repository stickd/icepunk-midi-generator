# Copy to .env.production. This file is a template: never use its placeholder
# values as secrets. Generate values with: openssl rand -base64 48

# Domains (public DNS A/AAAA records point to this VPS)
APP_DOMAIN=app.example.de
API_DOMAIN=api.example.de
FILES_DOMAIN=files.example.de
FRONTEND_URL=https://app.example.de
CORS_ALLOWED_ORIGINS=https://app.example.de
NEXT_PUBLIC_API_URL=https://api.example.de
NEXT_PUBLIC_STORAGE_ORIGIN=https://files.example.de
# Public GA4 measurement ID. Leave blank until the consent copy, privacy notice,
# processor assessment and release approval are complete.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
S3_PRESIGN_ENDPOINT=https://files.example.de
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

# PostgreSQL
POSTGRES_DB=icepunk
POSTGRES_USER=icepunk
POSTGRES_PASSWORD=<generate-random-32+-byte-secret>

# Redis (internal-only; limiter data has TTL and is not business data)
REDIS_MAXMEMORY=128mb
REDIS_MEMORY_LIMIT=256m
REDIS_CPU_LIMIT=0.25
REDIS_PIDS_LIMIT=64

# JWT/Auth
JWT_SECRET=<generate-random-32+-byte-secret>
JWT_EXPIRATION=7200000
AUTH_LOGIN_IP_LIMIT=5
AUTH_LOGIN_IDENTIFIER_LIMIT=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REGISTER_IP_LIMIT=3
AUTH_REGISTER_EMAIL_LIMIT=3
AUTH_REGISTER_WINDOW_SECONDS=3600
TRUSTED_PROXY_CIDRS=172.30.0.0/24

# Email
RESEND_API_KEY=re_replace_with_real_server_side_key
EMAIL_FROM=ICEPUNK <accounts@example.de>
EMAIL_VERIFICATION_EXPIRY_MINUTES=60
EMAIL_VERIFICATION_RESEND_LIMIT=3
EMAIL_VERIFICATION_RESEND_WINDOW_MINUTES=15

# S3/MinIO. App credentials are restricted to S3_BUCKET; root credentials are
# used only by the bootstrap container and must never be used by the backend.
MINIO_ROOT_USER=<minio-bootstrap-admin>
MINIO_ROOT_PASSWORD=<generate-random-32+-byte-secret>
S3_ACCESS_KEY=<generate-minio-app-access-key>
S3_SECRET_KEY=<generate-random-32+-byte-secret>
S3_BUCKET=icepunk-zips
S3_REGION=eu-central-1
S3_CONNECTION_TIMEOUT_SECONDS=3
S3_SOCKET_TIMEOUT_SECONDS=15
S3_API_CALL_TIMEOUT_SECONDS=30
S3_API_CALL_ATTEMPT_TIMEOUT_SECONDS=20
PRESIGNED_PREVIEW_TTL_SECONDS=600
PRESIGNED_DOWNLOAD_TTL_SECONDS=180

# Rate limiting / generator / temporary analysis
ICEPUNK_GENERATOR_TIMEOUT_SECONDS=60
ICEPUNK_GENERATOR_MAX_CONCURRENT=1
BACKEND_MEMORY_LIMIT=1536m
BACKEND_CPU_LIMIT=1.5
BACKEND_PIDS_LIMIT=256
FRONTEND_MEMORY_LIMIT=512m
FRONTEND_CPU_LIMIT=0.5
FRONTEND_PIDS_LIMIT=128
DATASETS_TEMP_MIDI_MAX_SIZE_BYTES=2097152
DATASETS_TEMP_RETENTION_HOURS=24
GENERATED_ZIP_RETENTION_DAYS=2

# Backup: external S3-compatible destination. It must be OFF-HOST. The backup
# job refuses to run until all of these are set.
BACKUP_LOCAL_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_S3_ENDPOINT=https://s3.example-backup-provider.com
BACKUP_S3_ACCESS_KEY=<off-host-backup-access-key>
BACKUP_S3_SECRET_KEY=<off-host-backup-secret>
BACKUP_S3_BUCKET=icepunk-offhost-backups
BACKUP_S3_PREFIX=production

# Operational bind addresses: only Caddy's 80/443 are publicly reachable.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8081
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9010
MINIO_CONSOLE_BIND_ADDRESS=127.0.0.1
MINIO_CONSOLE_PORT=9011
